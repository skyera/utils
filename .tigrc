# --- Visuals & Layout ---
set vertical-split = auto
set split-view-height = 70%
set split-view-width = 60%
set mouse = yes
set mouse-scroll = 3
set main-view-line-number = yes
set diff-view-line-number = yes
set tab-size = 4
set line-graphics = utf-8
set show-changes = yes

# Fixed main-view: graph is an option of commit-title, not a separate column
set main-view = date:default author:email-user,maxwidth=15 id:yes,color commit-title:graph=yes,refs=yes

color date             cyan   default
color cursor           black  yellow bold
color author           yellow default
color "---"            red    default
color "+++"            green  default
color "+ "             green  default
color "- "             red    default

# --- Behavior ---
set ignore-case = smart-case
set wrap-search = yes
set refresh-mode = auto
set diff-options = -C --diff-merges=m
set diff-context = 5

# --- Keybindings ---
# Diff & Pager View Scrolling
bind diff  <Ctrl-d>    scroll-half-page-down
bind diff  <Ctrl-u>    scroll-half-page-up
bind diff  <Ctrl-f>    scroll-page-down
bind diff  <Ctrl-b>    scroll-page-up
bind diff  <Ctrl-e>    scroll-line-down
bind diff  <Ctrl-y>    scroll-line-up

bind pager <Ctrl-d>    scroll-half-page-down
bind pager <Ctrl-u>    scroll-half-page-up
bind pager <Ctrl-f>    scroll-page-down
bind pager <Ctrl-b>    scroll-page-up
bind pager <Ctrl-e>    scroll-line-down
bind pager <Ctrl-y>    scroll-line-up

# Actions
bind generic W     :toggle diff-options --ignore-all-space
bind generic Y     !@sh -c "echo -n %(commit) | ~/test/utils/bin/osc52-yank.sh"
bind generic V     !nvim +%(line) %(file)

# --- Main View Actions ---
bind main    C     ?git checkout %(commit)
bind main    F     ?git commit --fixup=%(commit)
bind main    B     ?git rebase -i %(commit)~1
bind main    P     ?git cherry-pick %(commit)

# --- Status View Actions ---
bind status  C     !git commit
bind status  A     !git commit --amend
bind status  S     ?git stash save "%(prompt Enter stash name: )"
bind status  P     ?git stash pop

# --- Refs (Branch/Tag) View Actions ---
bind refs    C     ?git checkout %(branch)
bind refs    D     ?git branch -d %(branch)

# --- Diff View Actions ---
bind diff    [     :toggle diff-context -3
bind diff    ]     :toggle diff-context +3
