# General Search Options
--smart-case
--follow
--hidden

# Output Limiting (Prevents terminal lag on minified lines)
--max-columns=150
--max-columns-preview

# Tags & Index Files
--glob=!cscope.*
--glob=!tags
--glob=!filenametags

# Build Artifacts & Binaries
--glob=!*.o
--glob=!*.obj
--glob=!*.exe
--glob=!*.bin
--glob=!*.dll
--glob=!*.so
--glob=!*.dylib
--glob=!*.pdb
--glob=!*.class
--glob=!*.swp
--glob=!*.tmp
--glob=!*.lck
--glob=!*.pyc
--glob=!*.tar.gz
--glob=!*.zip

# Minified Assets & Lockfiles
--glob=!*.min.js
--glob=!*.min.css
--glob=!*.map
--glob=!package-lock.json
--glob=!pnpm-lock.yaml
--glob=!yarn.lock
--glob=!Cargo.lock

# Directories to Skip (Recursive matching)
--glob=!.git
--glob=!**/.cache/**
--glob=!**/__pycache__/**
--glob=!**/.venv/**
--glob=!**/.pytest_cache/**
--glob=!**/.mypy_cache/**
--glob=!**/node_modules/**
--glob=!**/build/**
--glob=!**/dist/**
--glob=!**/Debug/**
--glob=!**/Release/**
--glob=!**/obj/**
--glob=!**/.vs/**
--glob=!**/.vscode/**
--glob=!**/ThirdParty/**
