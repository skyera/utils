_get_omb_theme_script() {
    local osh="$1"
    local theme="$2"
    local dir="$osh/themes/$theme"
    if [[ -f "$dir/$theme.theme.sh" ]]; then
        echo "$dir/$theme.theme.sh"
    elif [[ -f "$dir/$theme.theme.bash" ]]; then
        echo "$dir/$theme.theme.bash"
    elif [[ -d "$dir" ]]; then
        local files=("$dir"/*.theme.*)
        if [[ -f "${files[0]}" ]]; then
            echo "${files[0]}"
        fi
    fi
}

switch_theme() {
    local theme="$1"
    export OSH=${OSH:-$HOME/.oh-my-bash}
    if [[ ! -d "$OSH/themes" ]]; then
        echo "Error: Oh-My-Bash themes directory not found at $OSH/themes"
        return 1
    fi

    # Interactive fzf selection if no argument is provided in terminal
    if [[ -z "$theme" ]]; then
        if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
            theme=$(find "$OSH/themes/" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort | \
                fzf --header="⚡ Select Oh-My-Bash Theme (Active: ${OSH_THEME:-font})" \
                    --layout=reverse \
                    --border=rounded \
                    --height=~15 \
                    --prompt="❯ " \
                    --pointer="▶ " \
                    --preview-window=hidden)
            [[ -z "$theme" ]] && return 0
        else
            echo "Usage: switch_theme [theme_name]"
            echo "Current theme: ${OSH_THEME:-font}"
            return 0
        fi
    fi

    local theme_script
    theme_script=$(_get_omb_theme_script "$OSH" "$theme")

    if [[ -n "$theme_script" && -f "$theme_script" ]]; then
        export OSH_THEME="$theme"
        export SCM_GIT_SHOW_MINIMAL_INFO=true
        export SCM_GIT_SHOW_REMOTE_INFO=false
        export SCM_GIT_SHOW_DETAILS=false
        export SCM_GIT_DISABLE_UNTRACKED_DIRTY=true
        export SCM_GIT_IGNORE_UNTRACKED=true
        if ! declare -f _omb_util_add_prompt_command >/dev/null 2>&1 && [[ -f "$OSH/oh-my-bash.sh" ]]; then
            plugins=($OMB_PLUGINS)
            aliases=($OMB_ALIASES)
            completions=($OMB_COMPLETIONS)
            source "$OSH/oh-my-bash.sh" 2>/dev/null
        else
            source "$theme_script" 2>/dev/null
        fi
        _apply_overrides
        echo "Switched Oh-My-Bash theme to: $theme"
    else
        echo "Error: Theme '$theme' not found in $OSH/themes/"
        return 1
    fi
}

