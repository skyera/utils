                __git_complete git.exe _git 2>/dev/null
            fi

            # Prevent completion from taking optional index locks or writing stat cache on disk (critical for 20GB+ repos)
            export GIT_OPTIONAL_LOCKS=0

            # Override __git helper to force fast native execution and disable optional locks during completion
            __git ()
            {
                GIT_OPTIONAL_LOCKS=0 command git ${__git_C_args:+"${__git_C_args[@]}"} ${__git_dir:+--git-dir="$__git_dir"} "$@" 2>/dev/null
            }

            # Override _git_add to support fast tab completion for `git add -f <prefix>` in large repos
            _git_add ()
            {
                case "$cur" in
                --chmod=*)
                    __gitcomp "+x -x" "" "${cur##--chmod=}"
                    return
                    ;;
                --*)
                    __gitcomp_builtin add
                    return
                    ;;
                esac

                local complete_opt="--others --modified --directory --no-empty-directory"
                if test -n "$(__git_find_on_cmdline "-u --update")"; then
                    complete_opt="--modified"
                fi
                if test -n "$(__git_find_on_cmdline "-f --force")"; then
                    complete_opt="$complete_opt --ignored"
                fi
                GIT_OPTIONAL_LOCKS=0 __git_complete_index_file "$complete_opt"
            }

            # Fallback _completion_loader if bash_completion package is missing
            if ! declare -F _completion_loader >/dev/null 2>&1; then
                _completion_loader() {
                    local cmd="$1"
                    local _gexec=""
                    command -v git >/dev/null 2>&1 && _gexec="$(git --exec-path 2>/dev/null)"
                    if [[ "$cmd" == "git" ]] || [[ "$cmd" == "git.exe" ]] || ! declare -F __git_complete >/dev/null 2>&1; then
                        for _git_comp_script in "$_gexec/../../share/git/completion/git-completion.bash" \
                                                "$_gexec/../../../share/git/completion/git-completion.bash" \
                                                "$_gexec/../../share/bash-completion/completions/git" \
                                                "/mingw64/share/git/completion/git-completion.bash" \
                                                "/mingw32/share/git/completion/git-completion.bash" \
                                                "/usr/share/bash-completion/completions/git" \
                                                "/usr/share/git-core/git-completion.bash" \
                                                "/usr/lib/git-core/git-completion.bash" \
                                                "/etc/bash_completion.d/git-completion.bash" \
                                                "/opt/homebrew/etc/bash_completion.d/git-completion.bash"; do
                            if [ -n "$_git_comp_script" ] && [ -f "$_git_comp_script" ]; then
                                source "$_git_comp_script"
                                return 0
                            fi
                        done
                    fi
                    for _comp_dir in "/usr/share/bash-completion/completions" \
                                     "$_gexec/../../share/bash-completion/completions" \
                                     "/mingw64/share/bash-completion/completions" \
                                     "/mingw32/share/bash-completion/completions"; do
                        if [ -n "$_comp_dir" ] && [ -f "$_comp_dir/$cmd" ]; then
                            source "$_comp_dir/$cmd"
                            return 0
                        fi
                    done
                    return 1
                }
            fi

            [ -f "$PLUGINS_DIR/forgit/completions/git-forgit.bash" ] && source "$PLUGINS_DIR/forgit/completions/git-forgit.bash"
        elif [[ -n "$ZSH_VERSION" ]]; then
            [ -f "$PLUGINS_DIR/forgit/completions/_git-forgit" ] && source "$PLUGINS_DIR/forgit/completions/_git-forgit"
        fi
    fi
fi

# Select 2 directories and pass them as environment variables to tmuxp to load dev with a custom session name
txp() {
    local repos_dir
    local container_dir
    local session_name

    if [ "$#" -ge 2 ]; then
        repos_dir="$1"
        container_dir="$2"
        session_name="$3"
    else
        echo "Select REPOS_DIR:"
        repos_dir=$(find /home/zliu/test -mindepth 1 -maxdepth 2 -type d -not -path '*/.*' 2>/dev/null | fzf --prompt="REPOS_DIR> ")
        if [ -z "$repos_dir" ]; then
            echo "Cancelled selecting REPOS_DIR"
            return 1
        fi
        echo "Selected REPOS_DIR: $repos_dir"

        echo "Select CONTAINER_DIR:"
        container_dir=$(find /home/zliu/test -mindepth 1 -maxdepth 2 -type d -not -path '*/.*' 2>/dev/null | fzf --prompt="CONTAINER_DIR> ")
        if [ -z "$container_dir" ]; then
            echo "Cancelled selecting CONTAINER_DIR"
            return 1
        fi
        echo "Selected CONTAINER_DIR: $container_dir"
    fi

    # Verify both directories exist
    if [ ! -d "$repos_dir" ]; then
        echo "Error: $repos_dir is not a directory."
        return 1
    fi
    if [ ! -d "$container_dir" ]; then
        echo "Error: $container_dir is not a directory."
        return 1
    fi

    # Determine default session name from repos_dir basename
    local default_name
    default_name=$(basename "$repos_dir")

    if [ -z "$session_name" ]; then
        if [ "$#" -ge 2 ]; then
            session_name="$default_name"
        else
            read -e -p "Enter session name (default: $default_name): " session_name
            session_name="${session_name:-$default_name}"
        fi
    fi

    # Sanitize session name for tmux (remove illegal characters like dots and colons)
    session_name=$(echo "$session_name" | tr -d '.:')

    # Export variables for tmuxp
    export REPOS_DIR="$repos_dir"
    export CONTAINER_DIR="$container_dir"

    # Start tmuxp with the custom session name
    echo "Loading tmuxp session: $session_name"
    tmuxp load dev -s "$session_name"
}


