_clean_prompt_command() {
    unset STARSHIP_PROMPT_COMMAND
    if declare -p PROMPT_COMMAND 2>/dev/null | grep -q "declare -a"; then
        local new_pc=()
        local pc
        for pc in "${PROMPT_COMMAND[@]}"; do
            if [[ "$pc" != *"_render_prompt"* && "$pc" != *"_set_bash_fallback_prompt"* && "$pc" != *"_omb_util_prompt_command_hook"* && "$pc" != *"starship"* ]]; then
                pc="${pc#"${pc%%[![:space:];]*}"}"
                pc="${pc%"${pc##*[![:space:];]}"}"
                [[ -n "$pc" ]] && new_pc+=("$pc")
            fi
        done
        PROMPT_COMMAND=("${new_pc[@]}")
    else
        local cmd new_str=""
        local raw="${PROMPT_COMMAND//$'\n'/;}"
        local IFS=";"
        local cmds
        read -ra cmds <<< "$raw"
        for cmd in "${cmds[@]}"; do
            cmd="${cmd#"${cmd%%[![:space:]]*}"}"
            cmd="${cmd%"${cmd##*[![:space:]]}"}"
            if [[ -n "$cmd" && "$cmd" != *"_render_prompt"* && "$cmd" != *"_set_bash_fallback_prompt"* && "$cmd" != *"_omb_util_prompt_command_hook"* && "$cmd" != *"starship"* ]]; then
                if [[ -z "$new_str" ]]; then
                    new_str="$cmd"
                else
                    new_str="$new_str; $cmd"
                fi
            fi
        done
        PROMPT_COMMAND="$new_str"
    fi
}

switch_prompt() {
    local style="$1"

    # Interactive fzf selection if no argument is provided in an interactive terminal
    if [[ -z "$style" ]]; then
        if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then
            local choice
            choice=$(printf "%b\n" "custom\t✦ Fast pastel prompt (Pure Bash, zero-subshell Git)\noh-my-bash\t🚀 Feature-rich Oh-My-Bash framework (Theme: ${OSH_THEME:-font})\nstarship\t🌌 Modern cross-shell Starship prompt" | \
                fzf --layout=reverse \
                    --border=rounded \
                    --height=~10 \
                    --delimiter='\t' \
                    --with-nth=1,2 \
                    --prompt="❯ " \
                    --pointer="▶ " \
                    --header="⚡ Select Shell Prompt Style (Active: $SH_PROMPT_STYLE)" \
                    --preview-window=hidden | cut -f1)
            [[ -z "$choice" ]] && return 0
            style="$choice"
        else
            echo "Usage: switch_prompt [custom | oh-my-bash | starship]"
            echo "Current style: $SH_PROMPT_STYLE"
            return 0
        fi
    fi

    if [[ "$style" == "oh-my-bash" || "$style" == "omb" ]]; then
        if [[ -n "$BASH_VERSION" ]]; then
            _clean_prompt_command
            export OSH=$HOME/.oh-my-bash
            if [ ! -d "$OSH" ]; then
                if command -v git >/dev/null 2>&1; then
                    echo -e "\033[32m[mybashrc] ~/.oh-my-bash not found. Automatically cloning oh-my-bash...\033[0m"
                    git clone --depth=1 https://github.com/ohmybash/oh-my-bash.git "$OSH"
                else
                    echo -e "\033[31m[mybashrc] Error: git is required to download oh-my-bash.\033[0m"
                    return 1
                fi
            fi
            
            if [ -f "$OSH/oh-my-bash.sh" ]; then
                export SH_PROMPT_STYLE="oh-my-bash"
                export SCM_GIT_SHOW_MINIMAL_INFO=true
                export SCM_GIT_SHOW_REMOTE_INFO=false
                export SCM_GIT_SHOW_DETAILS=false
                export SCM_GIT_DISABLE_UNTRACKED_DIRTY=true
                export SCM_GIT_IGNORE_UNTRACKED=true
                if ! declare -f _omb_util_add_prompt_command >/dev/null 2>&1; then
                    plugins=($OMB_PLUGINS)
                    aliases=($OMB_ALIASES)
                    completions=($OMB_COMPLETIONS)
                    source "$OSH/oh-my-bash.sh"
                else
                    if ((BASH_VERSINFO[0] * 10000 + BASH_VERSINFO[1] * 100 + BASH_VERSINFO[2] >= 50100)); then
                        local found=false
                        for pc in "${PROMPT_COMMAND[@]}"; do
                            [[ "$pc" == *"_omb_util_prompt_command_hook"* ]] && found=true
                        done
                        $found || PROMPT_COMMAND+=("_omb_util_prompt_command_hook")
                    else
                        [[ "$PROMPT_COMMAND" == *"_omb_util_prompt_command_hook"* ]] || PROMPT_COMMAND="_omb_util_prompt_command_hook; $PROMPT_COMMAND"
                    fi
                    
                    if declare -f _omb_theme_PROMPT_COMMAND >/dev/null 2>&1; then
                        _omb_theme_PROMPT_COMMAND
                    fi
                fi
                _apply_overrides
                echo "Switched prompt style to oh-my-bash (Theme: $OSH_THEME)"
            else
                echo "Error: oh-my-bash could not be loaded from $OSH"
                return 1
            fi
        else
            echo "oh-my-bash is only supported in Bash."
            return 1
        fi
    elif [[ "$style" == "custom" || "$style" == "my" ]]; then
        export SH_PROMPT_STYLE="custom"
        if [[ -n "$BASH_VERSION" ]]; then
            _clean_prompt_command
            if ((BASH_VERSINFO[0] * 10000 + BASH_VERSINFO[1] * 100 + BASH_VERSINFO[2] >= 50100)); then
                local found=false
                if declare -F _render_prompt >/dev/null 2>&1; then
                    for pc in "${PROMPT_COMMAND[@]}"; do
                        [[ "$pc" == *"_render_prompt"* ]] && found=true
                    done
                    $found || PROMPT_COMMAND+=('_render_prompt')
                else
                    for pc in "${PROMPT_COMMAND[@]}"; do
                        [[ "$pc" == *"_set_bash_fallback_prompt"* ]] && found=true
                    done
                    $found || PROMPT_COMMAND+=("_set_bash_fallback_prompt")
                fi
            else
                if declare -F _render_prompt >/dev/null 2>&1; then
                    [[ "$PROMPT_COMMAND" == *"_render_prompt"* ]] || PROMPT_COMMAND='_render_prompt'
                else
                    [[ "$PROMPT_COMMAND" == *"_set_bash_fallback_prompt"* ]] || PROMPT_COMMAND="_set_bash_fallback_prompt"
                fi
            fi
            if declare -F _render_prompt >/dev/null 2>&1; then
                _render_prompt
            elif declare -F _set_bash_fallback_prompt >/dev/null 2>&1; then
                _set_bash_fallback_prompt
            fi
            echo "Switched prompt style to custom mybashrc prompt."
        elif [[ -n "$ZSH_VERSION" ]]; then
            PROMPT='%(?..%F{203}[%?] %f)$(_zsh_conda_prompt)%F{85}%n@%m%f:%F{117}%~%f%F{141}${vcs_info_msg_0_}%f %F{214}$_PROMPT_CHAR%f '
            echo "Switched prompt style to custom mybashrc prompt."
        fi
    elif [[ "$style" == "starship" ]]; then
        if [[ -n "$BASH_VERSION" ]]; then
            _clean_prompt_command
            if command -v starship >/dev/null 2>&1; then
                export SH_PROMPT_STYLE="starship"
                eval "$(starship init bash)"
                if declare -f starship_precmd >/dev/null 2>&1; then
                    starship_precmd
                fi
                echo "Switched prompt style to starship."
            else
                echo -e "\033[33m[mybashrc] starship not found. Installing to $HOME/bin...\033[0m"
                mkdir -p "$HOME/bin"
                if curl -sS https://starship.rs/install.sh | sh -s -- --yes -b "$HOME/bin"; then
                    export PATH="$HOME/bin:$PATH"
                    export SH_PROMPT_STYLE="starship"
                    eval "$(starship init bash)"
                    if declare -f starship_precmd >/dev/null 2>&1; then
                        starship_precmd
                    fi
                    echo "Switched prompt style to starship."
                else
                    echo -e "\033[31m[mybashrc] Error: failed to install starship.\033[0m"
                    return 1
                fi
            fi
        elif [[ -n "$ZSH_VERSION" ]]; then
            if command -v starship >/dev/null 2>&1; then
                export SH_PROMPT_STYLE="starship"
                eval "$(starship init zsh)"
                echo "Switched prompt style to starship."
            else
                echo "starship is not installed. Run: curl -sS https://starship.rs/install.sh | sh"
                return 1
            fi
        fi
    else
        echo "Usage: switch_prompt [custom | oh-my-bash | starship]"
        echo "Current style: $SH_PROMPT_STYLE"
        return 1
    fi
}

